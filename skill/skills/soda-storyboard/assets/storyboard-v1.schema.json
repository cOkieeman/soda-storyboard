{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soda-storyboard.local/schema/storyboard-v1.schema.json",
  "title": "soda-storyboard v1",
  "oneOf": [
    {
      "$ref": "#/$defs/project"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/character"
    },
    {
      "$ref": "#/$defs/bundle"
    }
  ],
  "$defs": {
    "rect": {
      "type": "object",
      "required": [
        "type",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "type": {
          "const": "rect"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "quad": {
      "type": "object",
      "required": [
        "type",
        "points"
      ],
      "properties": {
        "type": {
          "const": "quad"
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "required": [
        "speaker_id",
        "text",
        "bubble"
      ],
      "properties": {
        "speaker_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "bubble": {
          "enum": [
            "speech",
            "shout",
            "thought",
            "narration"
          ]
        },
        "position": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "order",
        "shape"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "shape": {
          "oneOf": [
            {
              "$ref": "#/$defs/rect"
            },
            {
              "$ref": "#/$defs/quad"
            }
          ]
        },
        "shot": {
          "enum": [
            "extreme_long",
            "long",
            "full",
            "medium",
            "close_up",
            "extreme_close_up"
          ]
        },
        "angle": {
          "enum": [
            "eye",
            "high",
            "low",
            "bird",
            "worm",
            "dutch"
          ]
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "dialogue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogue"
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "needs_redraw"
          ]
        },
        "caption_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "production": {
          "$ref": "#/$defs/production"
        },
        "caption_auto_en": {
          "$ref": "#/$defs/caption_auto_en"
        },
        "use_custom_caption": {
          "type": "boolean",
          "default": false
        },
        "props": {
          "type": "string"
        },
        "atmosphere": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "overlay": {
      "type": "object",
      "required": [
        "id",
        "character_id",
        "rect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "panel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "character_id": {
          "type": "string",
          "minLength": 1
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "z_index": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "approved"
          ],
          "default": "planned"
        },
        "image_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "moss",
            "layer"
          ],
          "description": "New overlays should explicitly use moss; a missing mode in legacy JSON means layer."
        }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": [
        "format",
        "id",
        "canvas_width",
        "canvas_height",
        "panels"
      ],
      "properties": {
        "format": {
          "const": "soda-storyboard-page-v1"
        },
        "id": {
          "type": "string"
        },
        "canvas_width": {
          "type": "integer",
          "multipleOf": 16,
          "minimum": 16
        },
        "canvas_height": {
          "type": "integer",
          "multipleOf": 16,
          "minimum": 16
        },
        "reading_direction": {
          "enum": [
            "rtl",
            "ltr"
          ]
        },
        "style_prefix": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "panel_gap": {
          "type": "number",
          "minimum": 0
        },
        "text_direction": {
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "color_mode": {
          "enum": [
            "monochrome",
            "color"
          ]
        },
        "dialogue_mode": {
          "enum": [
            "moss_text",
            "lettering"
          ]
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "style_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "texts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "text_font_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 42
        },
        "text_max_chars": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "production": {
          "$ref": "#/$defs/production"
        },
        "caption_language": {
          "enum": [
            "en",
            "zh"
          ]
        },
        "legacy_caption_en": {
          "type": "boolean",
          "default": false
        },
        "canvas_mode": {
          "enum": [
            "panels",
            "single"
          ]
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_box"
          }
        },
        "moss_import": {
          "type": "object",
          "description": "Original MOSS summary, top-level fields and ordered item/entity snapshots for lossless import; preserve this metadata.",
          "required": [
            "entries",
            "summary",
            "top_level"
          ],
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "item"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "panel",
                      "text",
                      "object",
                      "passthrough"
                    ]
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "item": {},
                  "snapshot": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "summary": {
              "type": "object"
            },
            "top_level": {
              "type": "object"
            },
            "declared_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "format",
        "name"
      ],
      "properties": {
        "format": {
          "const": "soda-storyboard-project-v1"
        },
        "name": {
          "type": "string"
        },
        "default_style_prefix": {
          "type": "string"
        },
        "default_canvas_width": {
          "type": "integer",
          "multipleOf": 16,
          "minimum": 16
        },
        "default_canvas_height": {
          "type": "integer",
          "multipleOf": 16,
          "minimum": 16
        },
        "reading_direction": {
          "enum": [
            "rtl",
            "ltr"
          ]
        },
        "text_direction": {
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "color_mode": {
          "enum": [
            "monochrome",
            "color"
          ]
        },
        "default_dialogue_mode": {
          "enum": [
            "moss_text",
            "lettering"
          ]
        },
        "style_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comfy": {
          "$ref": "#/$defs/comfy"
        },
        "caption_language": {
          "enum": [
            "en",
            "zh"
          ],
          "default": "en"
        },
        "glossary": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "character": {
      "type": "object",
      "required": [
        "format",
        "id",
        "display_name"
      ],
      "properties": {
        "format": {
          "const": "soda-storyboard-character-v1"
        },
        "id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "trigger_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lora": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "strength": {
              "type": "number"
            }
          }
        },
        "appearance": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "clothing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approved_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "age": {
          "type": [
            "string",
            "null"
          ]
        },
        "figure_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional short English speaker name or role; preferred over display_name in text captions."
        }
      },
      "additionalProperties": true
    },
    "text": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "dialogue",
            "narration",
            "sfx",
            "title",
            "caption_tag"
          ]
        },
        "text": {
          "type": "string"
        },
        "panel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "enum": [
            "vertical",
            "horizontal",
            null
          ]
        },
        "bubble": {
          "enum": [
            "speech",
            "shout",
            "thought",
            "box",
            "none"
          ],
          "default": "speech"
        },
        "bbox": {
          "oneOf": [
            {
              "$ref": "#/$defs/text_rect"
            },
            {
              "type": "null"
            }
          ]
        },
        "style_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "render_mode": {
          "enum": [
            "moss_text",
            "lettering"
          ]
        }
      },
      "additionalProperties": true
    },
    "text_rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "type": {
          "const": "rect"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "figure": {
      "type": "object",
      "required": [
        "character_id"
      ],
      "properties": {
        "character_id": {
          "type": "string"
        },
        "pose": {
          "type": "string",
          "default": "stand",
          "description": "stand/walk/run/sit/crouch/wave/point/arms_up/hands_clasped/hand_on_chin/lie/back_view; unknown values warn and render stand."
        },
        "position": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "enum": [
                "left",
                "center",
                "right"
              ]
            }
          ]
        },
        "facing": {
          "enum": [
            "left",
            "right",
            "front",
            "back"
          ]
        },
        "framing": {
          "enum": [
            "full",
            "waist",
            "bust",
            "face",
            null
          ]
        },
        "bbox": {
          "type": "object",
          "description": "可选精确人物范围，页面左上角像素坐标，用于局部换人遮罩。",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "comfy": {
      "type": "object",
      "description": "项目级 ComfyUI 配置；模型路径相对 ComfyUI 模型目录。",
      "properties": {
        "url": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "preset": {
          "enum": [
            "draft",
            "final"
          ]
        },
        "backend": {
          "enum": [
            "minimal",
            "v2"
          ]
        },
        "workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "sft": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "clip": {
          "type": "string"
        },
        "vae": {
          "type": "string"
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "poll_interval": {
          "type": "number",
          "minimum": 0
        },
        "cut_inset": {
          "type": "number",
          "minimum": 0
        },
        "border_width": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "render": {
      "type": "object",
      "required": [
        "path",
        "seed"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "meta": {
          "type": "object"
        },
        "source_render": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "detail",
            "swap",
            "inpaint"
          ]
        },
        "character_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "denoise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resolved_characters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mask": {
          "type": [
            "string",
            "null"
          ]
        },
        "lora": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "production": {
      "type": "object",
      "description": "路径相对故事项目根目录；派生图记录签名以避免复用旧底图的结果。",
      "properties": {
        "renders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/render"
          }
        },
        "selected_render": {
          "type": "string"
        },
        "selected": {
          "type": "string"
        },
        "candidate_sheet": {
          "type": "string"
        },
        "composed": {
          "type": "object"
        },
        "lettered": {
          "type": "object"
        },
        "overlays": {
          "type": "object"
        },
        "split": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "caption_auto_en": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "translated_at": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "source_hash",
        "translated_at"
      ],
      "additionalProperties": true
    },
    "object_box": {
      "type": "object",
      "required": [
        "id",
        "rect",
        "caption"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "caption": {
          "type": "string"
        },
        "label": {
          "enum": [
            "object",
            "character"
          ],
          "default": "object"
        },
        "panel_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "bundle": {
      "type": "object",
      "required": [
        "format",
        "exported_at",
        "generator",
        "project",
        "page",
        "characters"
      ],
      "properties": {
        "format": {
          "const": "soda-storyboard-bundle-v1"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "string",
          "pattern": "^soda-storyboard "
        },
        "project": {
          "type": "object",
          "description": "Portable project settings, retaining forward-compatible fields and legacy aliases."
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/page"
            },
            {
              "type": "object",
              "required": [
                "panels"
              ],
              "properties": {
                "panels": {
                  "type": "array"
                }
              },
              "additionalProperties": true
            }
          ],
          "description": "Complete page including caption_auto_en and unknown fields; file metadata is portable."
        },
        "characters": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/character"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "description": "Only roles referenced by this page, keyed by matching character id; raw legacy aliases and extension fields are retained."
        },
        "sketch_png_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "contentMediaType": "image/png",
          "maxLength": 2796204,
          "description": "Optional PNG, long side 768; decoded size at most 2 MiB and 4,000,000 pixels."
        }
      },
      "additionalProperties": true
    }
  }
}
